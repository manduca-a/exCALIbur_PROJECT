# Excalibur Emergency Dispatch System - Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# REQUIRED: LLM Configuration
# ============================================================================
# Model to use for AI agents
# Options: "groq/llama-3.3-70b-versatile", "openai/gpt-4o", etc.
MODEL=groq/llama-3.3-70b-versatile

# GROQ API Key (for Llama inference)
# Get it at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ============================================================================
# REQUIRED: Google Maps API
# ============================================================================
# Google API Key (required for real-time traffic ETA calculations)
# Must have Google Maps API and Distance Matrix API enabled
# Get it at: https://console.cloud.google.com
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# OPTIONAL: Web Search (not currently used but configured in baseline)
# ============================================================================
# Serper API Key (for web search, optional)
# Get it at: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# ============================================================================
# OPTIONAL: Alternative LLM Providers (use if switching from Groq)
# ============================================================================
# Uncomment and fill if using OpenAI instead of Groq:
# OPENAI_API_KEY=your_openai_api_key_here

# Uncomment and fill if using Anthropic Claude:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
